include(CheckCXXSourceCompiles)

# Options
option(CONAN_OMP_BUILD_SHARED "Build Conan host dependencies as shared libraries" OFF)
option(CONAN_OMP_ANDROID_ARM_NEON "Enable NEON and Thumb instructions for Android ARMv7 Conan builds" OFF)

function(_conan_omp_normalize_build_type input output)
    string(TOUPPER "${input}" _type)
    if(_type STREQUAL "DEBUG")
        set(_normalized "Debug")
    elseif(_type STREQUAL "RELEASE")
        set(_normalized "Release")
    elseif(_type STREQUAL "RELWITHDEBINFO")
        set(_normalized "RelWithDebInfo")
    elseif(_type STREQUAL "MINSIZEREL")
        set(_normalized "MinSizeRel")
    else()
        set(_normalized "${input}")
    endif()
    set(${output} "${_normalized}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_os output)
    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        set(_os "Macos")
    elseif(CMAKE_SYSTEM_NAME STREQUAL "QNX")
        set(_os "Neutrino")
    elseif(CMAKE_SYSTEM_NAME)
        set(_os "${CMAKE_SYSTEM_NAME}")
    elseif(WIN32)
        set(_os "Windows")
    else()
        set(_os "")
    endif()
    set(${output} "${_os}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_arch output)
    if(CMAKE_SYSTEM_NAME STREQUAL "Android" AND ANDROID_ABI)
        if(ANDROID_ABI STREQUAL "armeabi-v7a")
            set(_arch "armv7")
        elseif(ANDROID_ABI STREQUAL "arm64-v8a")
            set(_arch "armv8")
        elseif(ANDROID_ABI STREQUAL "x86")
            set(_arch "x86")
        elseif(ANDROID_ABI STREQUAL "x86_64")
            set(_arch "x86_64")
        endif()
    elseif(TARGET_BUILD_ARCH)
        set(_arch "${TARGET_BUILD_ARCH}")
    elseif(MSVC_CXX_ARCHITECTURE_ID)
        string(TOLOWER "${MSVC_CXX_ARCHITECTURE_ID}" _arch_id)
        if(_arch_id MATCHES "(x64|x86_64|amd64)")
            set(_arch "x86_64")
        elseif(_arch_id MATCHES "(i[3-6]86|x86)")
            set(_arch "x86")
        elseif(_arch_id MATCHES "arm64")
            set(_arch "armv8")
        endif()
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(x64|x86_64|amd64)")
        set(_arch "x86_64")
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(i[3-6]86|x86)")
        set(_arch "x86")
    elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
        set(_arch "armv8")
    endif()

    if(NOT _arch)
        message(FATAL_ERROR "Unable to determine Conan architecture")
    endif()

    set(${output} "${_arch}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_compiler_version output compiler)
    string(REPLACE "." ";" _version_parts "${CMAKE_CXX_COMPILER_VERSION}")
    list(GET _version_parts 0 _major)
    list(LENGTH _version_parts _version_part_count)

    if(_compiler STREQUAL "clang" AND _major LESS 8)
        if(_version_part_count GREATER 1)
            list(GET _version_parts 1 _minor)
            set(_version "${_major}.${_minor}")
        else()
            set(_version "${_major}.0")
        endif()
    elseif(_compiler STREQUAL "apple-clang" OR _compiler STREQUAL "gcc")
        if(_version_part_count GREATER 1)
            list(GET _version_parts 1 _minor)
            set(_version "${_major}.${_minor}")
        else()
            set(_version "${_major}")
        endif()
    else()
        set(_version "${_major}")
    endif()

    set(${output} "${_version}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_android_ndk_path output)
    if(CMAKE_ANDROID_NDK)
        set(_ndk_path "${CMAKE_ANDROID_NDK}")
    elseif(ANDROID_NDK)
        set(_ndk_path "${ANDROID_NDK}")
    elseif(DEFINED ENV{ANDROID_NDK})
        set(_ndk_path "$ENV{ANDROID_NDK}")
    elseif(DEFINED ENV{ANDROID_NDK_ROOT})
        set(_ndk_path "$ENV{ANDROID_NDK_ROOT}")
    elseif(CMAKE_CXX_COMPILER)
        get_filename_component(_compiler_directory "${CMAKE_CXX_COMPILER}" DIRECTORY)
        string(REGEX REPLACE "[/\\\\]toolchains[/\\\\].*$" "" _ndk_path "${_compiler_directory}")
    endif()

    if(NOT _ndk_path OR NOT EXISTS "${_ndk_path}")
        message(FATAL_ERROR "Unable to determine the Android NDK path for Conan")
    endif()

    file(TO_CMAKE_PATH "${_ndk_path}" _ndk_path)
    set(${output} "${_ndk_path}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_android_ndk_host ndk_path output)
    set(_host_candidates)

    if(CMAKE_HOST_WIN32)
        list(APPEND _host_candidates "windows-x86_64")
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
        if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
            list(APPEND _host_candidates "darwin-arm64")
        endif()
        list(APPEND _host_candidates "darwin-x86_64")
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
            list(APPEND _host_candidates "linux-aarch64")
        endif()
        list(APPEND _host_candidates "linux-x86_64")
    endif()

    foreach(_host_candidate IN LISTS _host_candidates)
        if(EXISTS "${ndk_path}/toolchains/llvm/prebuilt/${_host_candidate}")
            set(${output} "${_host_candidate}" PARENT_SCOPE)
            return()
        endif()
    endforeach()

    message(FATAL_ERROR "Unable to find an official Android NDK host toolchain for ${CMAKE_HOST_SYSTEM_NAME} (${CMAKE_HOST_SYSTEM_PROCESSOR})")
endfunction()

function(_conan_omp_write_android_meson_wrappers ndk_path arch api_level c_output cpp_output ar_output)
    if(NOT CMAKE_C_COMPILER OR NOT CMAKE_CXX_COMPILER)
        message(FATAL_ERROR "Android Conan Meson integration requires C and C++ compilers")
    endif()

    _conan_omp_detect_android_ndk_host("${ndk_path}" _ndk_host)

    if(arch STREQUAL "armv7")
        set(_target_triple "armv7-none-linux-androideabi")
        set(_toolchain_prefix "arm-linux-androideabi")
        set(_sysroot_include "${ndk_path}/sysroot/usr/include/arm-linux-androideabi")
    elseif(arch STREQUAL "armv8")
        set(_target_triple "aarch64-none-linux-android")
        set(_toolchain_prefix "aarch64-linux-android")
        set(_sysroot_include "${ndk_path}/sysroot/usr/include/aarch64-linux-android")
    elseif(arch STREQUAL "x86")
        set(_target_triple "i686-none-linux-android")
        set(_toolchain_prefix "i686-linux-android")
        set(_sysroot_include "${ndk_path}/sysroot/usr/include/i686-linux-android")
    elseif(arch STREQUAL "x86_64")
        set(_target_triple "x86_64-none-linux-android")
        set(_toolchain_prefix "x86_64-linux-android")
        set(_sysroot_include "${ndk_path}/sysroot/usr/include/x86_64-linux-android")
    else()
        message(FATAL_ERROR "Unsupported Android architecture for Conan Meson integration: ${arch}")
    endif()

    set(_sysroot "${CMAKE_SYSROOT}")
    if(NOT _sysroot OR NOT EXISTS "${_sysroot}")
        if(arch STREQUAL "armv7")
            set(_platform_arch "arch-arm")
        elseif(arch STREQUAL "armv8")
            set(_platform_arch "arch-arm64")
        elseif(arch STREQUAL "x86")
            set(_platform_arch "arch-x86")
        elseif(arch STREQUAL "x86_64")
            set(_platform_arch "arch-x86_64")
        endif()

        set(_legacy_sysroot "${ndk_path}/platforms/android-${api_level}/${_platform_arch}")
        if(EXISTS "${_legacy_sysroot}")
            set(_sysroot "${_legacy_sysroot}")
        else()
            set(_sysroot "${ndk_path}/sysroot")
        endif()
    endif()

    file(TO_CMAKE_PATH "${CMAKE_C_COMPILER}" _c_compiler)
    file(TO_CMAKE_PATH "${CMAKE_CXX_COMPILER}" _cpp_compiler)
    file(TO_CMAKE_PATH "${_sysroot}" _sysroot)
    file(TO_CMAKE_PATH "${_sysroot_include}" _sysroot_include)

    file(GLOB _gcc_toolchain_candidates LIST_DIRECTORIES true
        "${ndk_path}/toolchains/${_toolchain_prefix}-*/prebuilt/${_ndk_host}"
    )
    list(SORT _gcc_toolchain_candidates)
    if(_gcc_toolchain_candidates)
        list(GET _gcc_toolchain_candidates 0 _gcc_toolchain)
    else()
        set(_gcc_toolchain "")
    endif()

    set(_compiler_arguments "--target=${_target_triple} --sysroot=\"${_sysroot}\"")
    if(_gcc_toolchain AND EXISTS "${_gcc_toolchain}")
        file(TO_CMAKE_PATH "${_gcc_toolchain}" _gcc_toolchain)
        string(APPEND _compiler_arguments " --gcc-toolchain=\"${_gcc_toolchain}\"")
    endif()

    set(_wrapper_directory "${CMAKE_BINARY_DIR}/conan")
    file(MAKE_DIRECTORY "${_wrapper_directory}")
    if(CMAKE_HOST_WIN32)
        set(_wrapper_extension ".cmd")
        set(_c_wrapper "${_wrapper_directory}/android_${arch}_clang${_wrapper_extension}")
        set(_cpp_wrapper "${_wrapper_directory}/android_${arch}_clangxx${_wrapper_extension}")
        file(WRITE "${_c_wrapper}" "@echo off\n\"${_c_compiler}\" ${_compiler_arguments} %*\n")
        file(WRITE "${_cpp_wrapper}" "@echo off\n\"${_cpp_compiler}\" ${_compiler_arguments} %*\n")
    else()
        set(_wrapper_extension ".sh")
        set(_c_wrapper "${_wrapper_directory}/android_${arch}_clang${_wrapper_extension}")
        set(_cpp_wrapper "${_wrapper_directory}/android_${arch}_clangxx${_wrapper_extension}")
        file(WRITE "${_c_wrapper}" "#!/bin/sh\nexec \"${_c_compiler}\" ${_compiler_arguments} \"$@\"\n")
        file(WRITE "${_cpp_wrapper}" "#!/bin/sh\nexec \"${_cpp_compiler}\" ${_compiler_arguments} \"$@\"\n")
        execute_process(
            COMMAND chmod +x "${_c_wrapper}" "${_cpp_wrapper}"
            RESULT_VARIABLE _chmod_result
        )
        if(NOT _chmod_result EQUAL 0)
            message(FATAL_ERROR "Unable to make Android Conan Meson wrappers executable")
        endif()
    endif()

    file(TO_CMAKE_PATH "${_c_wrapper}" _c_wrapper)
    file(TO_CMAKE_PATH "${_cpp_wrapper}" _cpp_wrapper)
    set(_legacy_ar "${_gcc_toolchain}/bin/${_toolchain_prefix}-ar")
    if(EXISTS "${_legacy_ar}")
        set(_ar "${_legacy_ar}")
    elseif(EXISTS "${_legacy_ar}.exe")
        set(_ar "${_legacy_ar}.exe")
    elseif(CMAKE_AR AND EXISTS "${CMAKE_AR}")
        set(_ar "${CMAKE_AR}")
    else()
        set(_ar "${ndk_path}/toolchains/llvm/prebuilt/${_ndk_host}/bin/llvm-ar")
        if(NOT EXISTS "${_ar}" AND EXISTS "${_ar}.exe")
            set(_ar "${_ar}.exe")
        endif()
    endif()
    file(TO_CMAKE_PATH "${_ar}" _ar)

    set(${c_output} "${_c_wrapper}" PARENT_SCOPE)
    set(${cpp_output} "${_cpp_wrapper}" PARENT_SCOPE)
    set(${ar_output} "${_ar}" PARENT_SCOPE)
    set(_sysroot_include "${_sysroot_include}" PARENT_SCOPE)
endfunction()

function(_conan_omp_android_has_target_drivers ndk_path arch api_level output)
    if(arch STREQUAL "armv7")
        set(_target_prefix "armv7a-linux-androideabi")
    elseif(arch STREQUAL "armv8")
        set(_target_prefix "aarch64-linux-android")
    elseif(arch STREQUAL "x86")
        set(_target_prefix "i686-linux-android")
    elseif(arch STREQUAL "x86_64")
        set(_target_prefix "x86_64-linux-android")
    else()
        set(${output} FALSE PARENT_SCOPE)
        return()
    endif()

    _conan_omp_detect_android_ndk_host("${ndk_path}" _ndk_host)

    set(_compiler_directory "${ndk_path}/toolchains/llvm/prebuilt/${_ndk_host}/bin")
    set(_target_compiler "${_compiler_directory}/${_target_prefix}${api_level}-clang")
    set(_target_compiler_cpp "${_compiler_directory}/${_target_prefix}${api_level}-clang++")
    set(_has_target_drivers FALSE)

    foreach(_extension IN ITEMS "" ".cmd" ".exe")
        if(EXISTS "${_target_compiler}${_extension}" AND EXISTS "${_target_compiler_cpp}${_extension}")
            set(_has_target_drivers TRUE)
            break()
        endif()
    endforeach()

    set(${output} "${_has_target_drivers}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_msvc_runtime runtime_output runtime_type_output build_type)
    if(CMAKE_MSVC_RUNTIME_LIBRARY)
        set(_runtime_library "${CMAKE_MSVC_RUNTIME_LIBRARY}")
    else()
        set(_runtime_library "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    endif()

    if(_runtime_library MATCHES "DLL$")
        set(_runtime "dynamic")
    else()
        set(_runtime "static")
    endif()

    _conan_omp_normalize_build_type("${build_type}" _normalized_build_type)
    if(_normalized_build_type STREQUAL "Debug")
        set(_runtime_type "Debug")
    else()
        set(_runtime_type "Release")
    endif()

    set(${runtime_output} "${_runtime}" PARENT_SCOPE)
    set(${runtime_type_output} "${_runtime_type}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_msvc_runtime_version output)
    if(MSVC_TOOLSET_VERSION)
        set(_runtime_version "v${MSVC_TOOLSET_VERSION}")
    elseif(CMAKE_VS_PLATFORM_TOOLSET_VERSION)
        string(REGEX MATCH "^[0-9]+" _toolset_digits "${CMAKE_VS_PLATFORM_TOOLSET_VERSION}")
        if(_toolset_digits)
            set(_runtime_version "v${_toolset_digits}")
        endif()
    elseif(CMAKE_VS_PLATFORM_TOOLSET MATCHES "^v([0-9]+)$")
        set(_runtime_version "v${CMAKE_MATCH_1}")
    endif()

    set(${output} "${_runtime_version}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_compiler compiler_output version_output runtime_output runtime_type_output runtime_version_output build_type)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        set(_compiler "msvc")
        string(SUBSTRING "${MSVC_VERSION}" 0 3 _compiler_version)
        _conan_omp_detect_msvc_runtime(_runtime _runtime_type "${build_type}")
        _conan_omp_detect_msvc_runtime_version(_runtime_version)
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
        if(WIN32 AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
            set(_compiler "msvc")
            string(SUBSTRING "${MSVC_VERSION}" 0 3 _compiler_version)
            _conan_omp_detect_msvc_runtime(_runtime _runtime_type "${build_type}")
            _conan_omp_detect_msvc_runtime_version(_runtime_version)
        else()
            set(_compiler "clang")
            _conan_omp_detect_compiler_version(_compiler_version "${_compiler}")
        endif()
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
        set(_compiler "apple-clang")
        _conan_omp_detect_compiler_version(_compiler_version "${_compiler}")
    elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        set(_compiler "gcc")
        _conan_omp_detect_compiler_version(_compiler_version "${_compiler}")
    else()
        message(FATAL_ERROR "Unsupported compiler for Conan 2 integration: ${CMAKE_CXX_COMPILER_ID}")
    endif()

    set(${compiler_output} "${_compiler}" PARENT_SCOPE)
    set(${version_output} "${_compiler_version}" PARENT_SCOPE)
    set(${runtime_output} "${_runtime}" PARENT_SCOPE)
    set(${runtime_type_output} "${_runtime_type}" PARENT_SCOPE)
    set(${runtime_version_output} "${_runtime_version}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_cppstd output compiler)
    if(NOT CMAKE_CXX_STANDARD)
        set(${output} "" PARENT_SCOPE)
        return()
    endif()

    set(_cppstd "${CMAKE_CXX_STANDARD}")
    if(CMAKE_CXX_EXTENSIONS AND NOT compiler STREQUAL "msvc")
        set(_cppstd "gnu${CMAKE_CXX_STANDARD}")
    endif()
    set(${output} "${_cppstd}" PARENT_SCOPE)
endfunction()

function(_conan_omp_get_directory_compile_options output)
    get_directory_property(_compile_options DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR} COMPILE_OPTIONS)
    string(GENEX_STRIP "${_compile_options}" _compile_options)
    set(${output} "${_compile_options}" PARENT_SCOPE)
endfunction()

function(_conan_omp_get_directory_compile_definitions output)
    get_directory_property(_defines DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR} COMPILE_DEFINITIONS)
    string(GENEX_STRIP "${_defines}" _defines)
    set(${output} "${_defines}" PARENT_SCOPE)
endfunction()

function(_conan_omp_detect_libcxx output compiler)
    if(WIN32 OR compiler STREQUAL "msvc")
        set(${output} "" PARENT_SCOPE)
        return()
    endif()

    if(DEFINED CMAKE_CXX_STDLIB AND CMAKE_CXX_STDLIB STREQUAL "libc++")
        set(${output} "libc++" PARENT_SCOPE)
        return()
    endif()

    _conan_omp_get_directory_compile_options(_compile_options)
    _conan_omp_get_directory_compile_definitions(_defines)

    foreach(_define IN LISTS _defines)
        if(_define MATCHES "_GLIBCXX_USE_CXX11_ABI")
            if(_define MATCHES "^-D")
                list(APPEND _compile_options "${_define}")
            else()
                list(APPEND _compile_options "-D${_define}")
            endif()
        endif()
    endforeach()

    set(_expand_cxx_compiler ${CMAKE_CXX_COMPILER})
    if(CMAKE_CXX_COMPILER_ARG1)
        separate_arguments(_split_cxx_compiler_arg1 NATIVE_COMMAND ${CMAKE_CXX_COMPILER_ARG1})
        list(APPEND _expand_cxx_compiler ${_split_cxx_compiler_arg1})
    endif()

    if(CMAKE_CXX_COMPILE_OPTIONS_TARGET AND CMAKE_CXX_COMPILER_TARGET)
        list(APPEND _expand_cxx_compiler "${CMAKE_CXX_COMPILE_OPTIONS_TARGET}${CMAKE_CXX_COMPILER_TARGET}")
    endif()

    if(CMAKE_CXX_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN AND CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN)
        list(APPEND _expand_cxx_compiler "${CMAKE_CXX_COMPILE_OPTIONS_EXTERNAL_TOOLCHAIN}${CMAKE_CXX_COMPILER_EXTERNAL_TOOLCHAIN}")
    endif()

    if(CMAKE_CXX_COMPILE_OPTIONS_SYSROOT)
        if(CMAKE_SYSROOT_COMPILE)
            list(APPEND _expand_cxx_compiler "${CMAKE_CXX_COMPILE_OPTIONS_SYSROOT}${CMAKE_SYSROOT_COMPILE}")
        elseif(CMAKE_SYSROOT)
            list(APPEND _expand_cxx_compiler "${CMAKE_CXX_COMPILE_OPTIONS_SYSROOT}${CMAKE_SYSROOT}")
        endif()
    endif()

    separate_arguments(_split_cxx_flags NATIVE_COMMAND ${CMAKE_CXX_FLAGS})

    if(CMAKE_OSX_SYSROOT)
        set(_xcode_sysroot_option "--sysroot=${CMAKE_OSX_SYSROOT}")
    endif()

    execute_process(
        COMMAND ${CMAKE_COMMAND} -E echo "#include <string>"
        COMMAND ${_expand_cxx_compiler} ${_split_cxx_flags} -x c++ ${_xcode_sysroot_option} ${_compile_options} -E -dM -
        OUTPUT_VARIABLE _string_defines
        ERROR_QUIET
    )

    if(_string_defines MATCHES "#define __GLIBCXX__")
        if(DEFINED _GLIBCXX_USE_CXX11_ABI)
            if(_GLIBCXX_USE_CXX11_ABI)
                set(${output} "libstdc++11" PARENT_SCOPE)
                return()
            else()
                set(${output} "libstdc++" PARENT_SCOPE)
                return()
            endif()
        endif()

        if(_string_defines MATCHES "#define _GLIBCXX_USE_CXX11_ABI 1\n")
            set(${output} "libstdc++11" PARENT_SCOPE)
        else()
            set(${output} "libstdc++" PARENT_SCOPE)
        endif()
    else()
        set(${output} "libc++" PARENT_SCOPE)
    endif()
endfunction()

function(_conan_omp_append_profile_compilers profile_var compiler)
    set(_profile "${${profile_var}}")
    if(CMAKE_C_COMPILER AND NOT compiler STREQUAL "msvc")
        set(_c_compiler "${CMAKE_C_COMPILER}")
        set(_cpp_compiler "${CMAKE_CXX_COMPILER}")
        if(ARGC GREATER 2 AND ARGV2)
            set(_c_compiler "${ARGV2}")
        endif()
        if(ARGC GREATER 3 AND ARGV3)
            set(_cpp_compiler "${ARGV3}")
        endif()

        string(APPEND _profile "tools.build:compiler_executables={")
        string(APPEND _profile "\"c\":\"${_c_compiler}\"")
        if(_cpp_compiler)
            string(APPEND _profile ",\"cpp\":\"${_cpp_compiler}\"")
        endif()
        string(APPEND _profile "}\n")
    endif()
    set(${profile_var} "${_profile}" PARENT_SCOPE)
endfunction()

function(_conan_omp_write_host_profile output build_type)
    _conan_omp_detect_os(_os)
    _conan_omp_detect_arch(_arch)
    _conan_omp_detect_compiler(_compiler _compiler_version _runtime _runtime_type _runtime_version "${build_type}")
    _conan_omp_detect_cppstd(_cppstd "${_compiler}")
    _conan_omp_detect_libcxx(_libcxx "${_compiler}")

    set(_profile "[settings]\n")
    string(APPEND _profile "arch=${_arch}\n")
    if(_os)
        string(APPEND _profile "os=${_os}\n")
    endif()
    if(_os STREQUAL "Android")
        set(_android_api_level "${CMAKE_SYSTEM_VERSION}")
        if(NOT _android_api_level)
            set(_android_api_level "${ANDROID_PLATFORM}")
        endif()
        string(REGEX REPLACE "^android-" "" _android_api_level "${_android_api_level}")
        if(NOT _android_api_level MATCHES "^[0-9]+$")
            message(FATAL_ERROR "Unable to determine Android API level for Conan profile")
        endif()
        string(APPEND _profile "os.api_level=${_android_api_level}\n")
        _conan_omp_detect_android_ndk_path(_android_ndk_path)
        _conan_omp_write_android_meson_wrappers(
            "${_android_ndk_path}"
            "${_arch}"
            "${_android_api_level}"
            _android_meson_c
            _android_meson_cpp
            _android_meson_ar
        )
        _conan_omp_android_has_target_drivers(
            "${_android_ndk_path}"
            "${_arch}"
            "${_android_api_level}"
            _android_has_target_drivers
        )
        if(_android_meson_c)
            set(_android_replace_meson TRUE)
        endif()
        if(_arch STREQUAL "armv7" AND (CONAN_OMP_ANDROID_ARM_NEON OR CMAKE_ANDROID_ARM_NEON))
            set(_android_user_toolchain_path "${CMAKE_BINARY_DIR}/conan/android_neon.cmake")
            file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/conan")
            file(WRITE "${_android_user_toolchain_path}" "set(CMAKE_ANDROID_ARM_NEON TRUE)\nset(ANDROID_ARM_NEON TRUE)\n")
            file(TO_CMAKE_PATH "${_android_user_toolchain_path}" _android_user_toolchain_path)
        endif()
    endif()
    string(APPEND _profile "compiler=${_compiler}\n")
    string(APPEND _profile "compiler.version=${_compiler_version}\n")
    if(_runtime)
        string(APPEND _profile "compiler.runtime=${_runtime}\n")
    endif()
    if(_runtime_version AND NOT _compiler STREQUAL "msvc")
        string(APPEND _profile "compiler.runtime_version=${_runtime_version}\n")
    endif()
    if(_cppstd)
        string(APPEND _profile "compiler.cppstd=${_cppstd}\n")
    endif()
    if(_libcxx)
        string(APPEND _profile "compiler.libcxx=${_libcxx}\n")
    endif()

    if(_android_replace_meson)
        string(APPEND _profile "[replace_tool_requires]\n")
        string(APPEND _profile "meson/*: meson/1.3.2\n")
    endif()

    string(APPEND _profile "[conf]\n")
    if(_os STREQUAL "Android")
        # The Android NDK Clang compiler is not the Visual Studio ClangCL toolset.
        set(_conan_cmake_generator "Ninja")
    else()
        set(_conan_cmake_generator "${CMAKE_GENERATOR}")
    endif()
    string(APPEND _profile "tools.cmake.cmaketoolchain:generator=${_conan_cmake_generator}\n")
    if(_os STREQUAL "Linux" AND _arch STREQUAL "x86")
        string(APPEND _profile "tools.build:sharedlinkflags=[\"-latomic\"]\n")
        string(APPEND _profile "tools.build:exelinkflags=[\"-latomic\"]\n")
    endif()
    if(_os STREQUAL "Android")
        string(APPEND _profile "tools.android:ndk_path=${_android_ndk_path}\n")
        if(_android_user_toolchain_path)
            string(APPEND _profile "tools.cmake.cmaketoolchain:user_toolchain=[\"${_android_user_toolchain_path}\"]\n")
        endif()
        if(_android_meson_c)
            string(APPEND _profile "tools.meson.mesontoolchain:extra_variables={\"binaries\":{\"c\":\"${_android_meson_c}\",\"cpp\":\"${_android_meson_cpp}\",\"ar\":\"${_android_meson_ar}\"}}\n")
        endif()
        set(_android_flags "-D__ANDROID_API__=${_android_api_level}" "-DANDROID")
        set(_android_sysroot_include "${_android_ndk_path}/sysroot/usr/include")
        if(EXISTS "${_android_sysroot_include}")
            list(APPEND _android_flags "-isystem" "${_android_sysroot_include}")
        endif()
        if(_sysroot_include AND EXISTS "${_sysroot_include}")
            list(APPEND _android_flags "-isystem" "${_sysroot_include}")
        endif()
        if(_arch STREQUAL "armv7" AND (CONAN_OMP_ANDROID_ARM_NEON OR CMAKE_ANDROID_ARM_NEON))
            list(APPEND _android_flags "-mfpu=neon" "-mthumb")
        endif()
        string(REPLACE ";" "\", \"" _android_flags_text "${_android_flags}")
        string(APPEND _profile "tools.build:cflags=[\"${_android_flags_text}\"]\n")
        string(APPEND _profile "tools.build:cxxflags=[\"${_android_flags_text}\"]\n")
    endif()
    if(_os STREQUAL "Android" AND _android_meson_c AND NOT _android_has_target_drivers)
        _conan_omp_append_profile_compilers(
            _profile
            "${_compiler}"
            "${_android_meson_c}"
            "${_android_meson_cpp}"
        )
    else()
        _conan_omp_append_profile_compilers(_profile "${_compiler}")
    endif()
    if(_os STREQUAL "Android" AND _android_meson_c AND NOT _android_has_target_drivers)
        string(APPEND _profile "[buildenv]\n")
        string(APPEND _profile "CC=${_android_meson_c}\n")
        string(APPEND _profile "CXX=${_android_meson_cpp}\n")
        string(APPEND _profile "AR=${_android_meson_ar}\n")
        get_filename_component(_android_ar_name "${_android_meson_ar}" NAME)
        get_filename_component(_android_bin_directory "${_android_meson_ar}" DIRECTORY)
        string(REGEX REPLACE "-ar(\\.exe)?$" "" _android_tool_prefix "${_android_ar_name}")
        if(CMAKE_HOST_WIN32)
            set(_android_tool_suffix ".exe")
        else()
            set(_android_tool_suffix "")
        endif()
        foreach(_tool IN ITEMS ld strip ranlib addr2line nm objcopy objdump readelf elfedit)
            string(TOLOWER "${_tool}" _tool_file)
            string(TOUPPER "${_tool}" _tool_variable)
            string(APPEND _profile "${_tool_variable}=${_android_bin_directory}/${_android_tool_prefix}-${_tool_file}${_android_tool_suffix}\n")
        endforeach()
    endif()

    set(_profile_path "${CMAKE_BINARY_DIR}/conan/omp_host.profile")
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/conan")
    file(WRITE "${_profile_path}" "${_profile}")
    set(${output} "${_profile_path}" PARENT_SCOPE)
endfunction()

function(_conan_omp_ensure_default_profile)
    conan_check(REQUIRED DETECT_QUIET)

    execute_process(
        COMMAND ${CONAN_CMD} profile path default
        RESULT_VARIABLE _return_code
        OUTPUT_QUIET
        ERROR_QUIET
        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
    )
    if(NOT _return_code EQUAL 0)
        execute_process(
            COMMAND ${CONAN_CMD} profile detect
            RESULT_VARIABLE _detect_return_code
            WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
        )
        if(NOT _detect_return_code EQUAL 0)
            message(FATAL_ERROR "Couldn't create Conan default profile")
        endif()
    endif()
endfunction()

function(_conan_omp_translate_option option_value output)
    if(NOT option_value)
        set(${output} "" PARENT_SCOPE)
        return()
    endif()

    if(option_value MATCHES "^[^/:]+:[^=]+=")
        string(REPLACE ":" "/*:" _translated "${option_value}")
    else()
        set(_translated "${option_value}")
    endif()

    set(${output} "${_translated}" PARENT_SCOPE)
endfunction()

function(_conan_omp_package_file_name pkg_name output)
    if(pkg_name STREQUAL "openssl")
        set(_file_name "OpenSSL")
    elseif(pkg_name STREQUAL "sqlite3")
        set(_file_name "SQLite3")
    elseif(pkg_name STREQUAL "icu")
        set(_file_name "ICU")
    elseif(pkg_name STREQUAL "ghc-filesystem")
        set(_file_name "ghc_filesystem")
    else()
        set(_file_name "${pkg_name}")
    endif()
    set(${output} "${_file_name}" PARENT_SCOPE)
endfunction()

function(_conan_omp_package_target_name pkg_name output)
    if(pkg_name STREQUAL "nlohmann_json")
        set(_target "nlohmann_json::nlohmann_json")
    elseif(pkg_name STREQUAL "openssl")
        set(_target "OpenSSL::SSL;OpenSSL::Crypto")
    elseif(pkg_name STREQUAL "ghc-filesystem")
        set(_target "ghcFilesystem::ghc_filesystem")
    elseif(pkg_name STREQUAL "sqlite3")
        set(_target "SQLite::SQLite3")
    elseif(pkg_name STREQUAL "icu")
        set(_target "icu::icu")
    elseif(pkg_name STREQUAL "freetype")
        set(_target "Freetype::Freetype")
    elseif(pkg_name STREQUAL "opus")
        set(_target "Opus::opus")
    elseif(pkg_name STREQUAL "zlib")
        set(_target "ZLIB::ZLIB")
    elseif(pkg_name STREQUAL "libelfin")
        set(_target "libelfin::libelfin")
    elseif(pkg_name STREQUAL "cxxopts")
        set(_target "cxxopts::cxxopts")
    else()
        set(_target "${pkg_name}::${pkg_name}")
    endif()
    set(${output} "${_target}" PARENT_SCOPE)
endfunction()

function(_conan_omp_apply_msvc_include_workaround target_name)
    if(NOT MSVC OR MSVC_TOOLSET_VERSION LESS 142)
        return()
    endif()

    get_target_property(_include_dirs "${target_name}" INTERFACE_INCLUDE_DIRECTORIES)
    if(NOT _include_dirs OR _include_dirs STREQUAL "_include_dirs-NOTFOUND")
        return()
    endif()

    foreach(_include_dir IN LISTS _include_dirs)
        target_compile_options("${target_name}" INTERFACE "/I\"${_include_dir}\"")
    endforeach()
endfunction()

function(_conan_omp_install_package pkg_name pkg_version pkg_options)
    get_property(_already_added GLOBAL PROPERTY CONAN_OMP_ADDED_LIBS)
    if(_already_added)
        list(FIND _already_added "${pkg_name}" _already_added_index)
        if(NOT _already_added_index EQUAL -1)
            return()
        endif()
    endif()

    conan_check(REQUIRED DETECT_QUIET)
    _conan_omp_ensure_default_profile()

    get_property(_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
    if(_multi_config)
        set(_build_configs ${CMAKE_CONFIGURATION_TYPES})
    else()
        if(NOT CMAKE_BUILD_TYPE)
            message(FATAL_ERROR "Please specify CMAKE_BUILD_TYPE for Conan 2 dependency installation")
        endif()
        set(_build_configs ${CMAKE_BUILD_TYPE})
    endif()

    list(GET _build_configs 0 _profile_build_type)
    _conan_omp_write_host_profile(_host_profile "${_profile_build_type}")

    set(_output_folder "${CMAKE_BINARY_DIR}/conan/${pkg_name}")
    file(MAKE_DIRECTORY "${_output_folder}")

    _conan_omp_translate_option("${pkg_options}" _translated_pkg_option)

    foreach(_build_config IN LISTS _build_configs)
        _conan_omp_normalize_build_type("${_build_config}" _normalized_build_type)
        _conan_omp_detect_compiler(_compiler _compiler_version _runtime _runtime_type _runtime_version "${_normalized_build_type}")

        if(CONAN_OMP_BUILD_SHARED)
            set(_conan_shared_option "True")
        else()
            set(_conan_shared_option "False")
        endif()

        set(_conan_args install
            "--requires=${pkg_name}/${pkg_version}"
            "--output-folder=${_output_folder}"
            "--generator=CMakeDeps"
            "--generator=CMakeToolchain"
            "--build=missing"
            "--profile:host=${_host_profile}"
            "--profile:build=default"
            "--settings:host=build_type=${_normalized_build_type}"
            "--options:host=*/*:shared=${_conan_shared_option}"
        )

        if(_runtime_type)
            list(APPEND _conan_args "--settings:host=compiler.runtime_type=${_runtime_type}")
        endif()

        if(_translated_pkg_option)
            foreach(_opt IN LISTS _translated_pkg_option)
                list(APPEND _conan_args "--options:host=${_opt}")
            endforeach()
        endif()

        string(REPLACE ";" " " _conan_args_log "${_conan_args}")
        message(STATUS "Conan executing: ${CONAN_CMD} ${_conan_args_log}")
        execute_process(
            COMMAND ${CONAN_CMD} ${_conan_args}
            RESULT_VARIABLE _return_code
            WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
        )
        if(NOT _return_code EQUAL 0)
            message(FATAL_ERROR "Conan install failed for ${pkg_name}/${pkg_version}")
        endif()
    endforeach()

    _conan_omp_package_file_name("${pkg_name}" _package_file_name)
    _conan_omp_package_target_name("${pkg_name}" _package_target_name)

    set(_saved_cmake_prefix_path "${CMAKE_PREFIX_PATH}")
    set(_saved_cmake_module_path "${CMAKE_MODULE_PATH}")
    list(PREPEND CMAKE_PREFIX_PATH "${_output_folder}")
    list(PREPEND CMAKE_MODULE_PATH "${_output_folder}")

    find_package(
        ${_package_file_name}
        CONFIG REQUIRED
        PATHS "${_output_folder}"
        NO_DEFAULT_PATH
    )

    set(CMAKE_PREFIX_PATH "${_saved_cmake_prefix_path}")
    set(CMAKE_MODULE_PATH "${_saved_cmake_module_path}")

    foreach(_package_target IN LISTS _package_target_name)
        if(NOT TARGET "${_package_target}")
            message(FATAL_ERROR "Expected Conan target '${_package_target}' was not generated for ${pkg_name}/${pkg_version}")
        endif()
    endforeach()

    if(NOT TARGET CONAN_PKG::${pkg_name})
        add_library(CONAN_PKG::${pkg_name} INTERFACE IMPORTED GLOBAL)
    endif()

    set_property(TARGET CONAN_PKG::${pkg_name} PROPERTY INTERFACE_LINK_LIBRARIES "${_package_target_name}")
    foreach(_package_target IN LISTS _package_target_name)
        _conan_omp_apply_msvc_include_workaround("${_package_target}")
    endforeach()
    _conan_omp_apply_msvc_include_workaround("CONAN_PKG::${pkg_name}")

    set_property(GLOBAL APPEND PROPERTY CONAN_OMP_ADDED_LIBS "${pkg_name}")
endfunction()

if(NOT TARGET_BUILD_ARCH)
    if(ANDROID_ABI)
        if(ANDROID_ABI STREQUAL "armeabi-v7a")
            set(TARGET_BUILD_ARCH armv7)
        elseif(ANDROID_ABI STREQUAL "arm64-v8a")
            set(TARGET_BUILD_ARCH armv8)
        elseif(ANDROID_ABI STREQUAL "x86")
            set(TARGET_BUILD_ARCH x86)
        elseif(ANDROID_ABI STREQUAL "x86_64")
            set(TARGET_BUILD_ARCH x86_64)
        else()
            message(FATAL_ERROR "Unsupported Android ABI '${ANDROID_ABI}'")
        endif()
    elseif(MSVC_CXX_ARCHITECTURE_ID)
        string(TOLOWER "${MSVC_CXX_ARCHITECTURE_ID}" LOWERCASE_CMAKE_SYSTEM_PROCESSOR)
        if(LOWERCASE_CMAKE_SYSTEM_PROCESSOR MATCHES "(x64|x86_64|amd64)")
            set(TARGET_BUILD_ARCH x86_64)
        elseif(LOWERCASE_CMAKE_SYSTEM_PROCESSOR MATCHES "(i[3-6]86|x86)")
            set(TARGET_BUILD_ARCH x86)
        else()
            message(FATAL_ERROR "MSVC Arch ID: Unknown CPU '${LOWERCASE_CMAKE_SYSTEM_PROCESSOR}'")
        endif()
    else()
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "(x64|x86_64|amd64)")
            set(TARGET_BUILD_ARCH x86_64)
        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "(i[3-6]86|x86)")
            set(TARGET_BUILD_ARCH x86)
            set(CMAKE_C_FLAGS "-m32 ${CMAKE_C_FLAGS}")
            set(CMAKE_CXX_FLAGS "-m32 ${CMAKE_CXX_FLAGS}")
            set(CMAKE_SIZEOF_VOID_P 4)
        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
            set(TARGET_BUILD_ARCH armv8)
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Android")
            message(FATAL_ERROR "Unable to determine Android Conan architecture; set ANDROID_ABI")
        else()
            set(TARGET_BUILD_ARCH x86)
        endif()
    endif()
endif()

# Automatically download and set up paths to a library on Conan.
# Works for multi-configuration generators by installing all requested configs
# into the same CMakeDeps output folder.
function(conan_omp_add_lib_opt pkg_name pkg_version pkg_options)
    _conan_omp_install_package("${pkg_name}" "${pkg_version}" "${pkg_options}")
endfunction()

function(conan_omp_add_lib pkg_name pkg_version)
    conan_omp_add_lib_opt("${pkg_name}" "${pkg_version}" "")
endfunction()
